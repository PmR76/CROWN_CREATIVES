/* ============================================================
   THEME PANEL — CLEAN + FIXED VERSION
============================================================ */

#theme-panel {
  position: fixed;
  top: 120px;
  left: 120px;
  width: 260px;
  background: rgba(20, 20, 20, 0.85);
  color: #fff;
  border-radius: 10px;
  opacity: 0;
  pointer-events: none;
  transform: translateY(10px);
  transition: opacity 0.25s ease, transform 0.25s ease;
  z-index: 999;
}

#theme-panel.theme-panel-visible {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

#theme-panel-header {
  cursor: grab;
}

#theme-panel-header:active {
  cursor: grabbing;
}

#theme-panel-close {
  cursor: pointer;
  transition: opacity 0.2s ease;
}

#theme-panel-close:hover {
  opacity: 0.6;
}

/* ------------------------------------------------------------
   SWATCHES — FIXED
------------------------------------------------------------ */
.theme-swatch {
  display: block;                 /* FIX: ensures swatch occupies space */
  width: 100%;
  min-height: 40px;               /* FIX: prevents collapse */
  height: 40px;
  border-radius: 6px;
  cursor: pointer;
  border: 2px solid rgba(255,255,255,0.2);

  background-size: cover;         /* FIX: ensures gradient fills */
  background-position: center;
  background-repeat: no-repeat;
  background-clip: padding-box;   /* FIX: prevents bleed */

  position: relative;             /* FIX: ensures z-index works */
  z-index: 2;                     /* FIX: prevents overlay blocking */

  overflow: hidden;               /* FIX: prevents pseudo-element overlap */

  transition: transform 0.2s ease, border-color 0.2s ease;
}

.theme-swatch:hover {
  transform: scale(1.05);
  border-color: rgba(255,255,255,0.5);
}

.theme-swatch.selected {
  border-color: #fff;
  transform: scale(1.08);
}


/* ------------------------------------------------------------
   GRID
------------------------------------------------------------ */
.theme-swatch-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
  margin-bottom: 20px;
  position: relative;
  z-index: 2;
}

/* ------------------------------------------------------------
   SCROLL AREA
------------------------------------------------------------ */
.theme-panel-body {
  max-height: 400px;
  overflow-y: auto;
  position: relative;
  z-index: 1;
}

/* ------------------------------------------------------------
   REMOVE BROKEN ::before BACKGROUND
------------------------------------------------------------ */
/* (This was covering the swatches — removed completely) */
.theme-panel-button {
  width: 100%;
  padding: 10px;
  margin: 10px 0 20px 0;
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 6px;
  color: #fff;
  cursor: pointer;
  transition: background 0.2s ease;
}

.theme-panel-button:hover {
  background: rgba(255,255,255,0.2);
}
.theme-panel {
  position: fixed;
  left: 40px; /* instead of right */
  top: 80px;
}
